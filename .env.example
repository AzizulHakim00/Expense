# Copy this file to .env for local IntelliJ/terminal use.
# Paste your MongoDB Atlas URI as the value. Do NOT commit the real .env file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/expense_db?retryWrites=true&w=majority
MONGODB_DATABASE=expense_db
PORT=8080
THYMELEAF_CACHE=false
